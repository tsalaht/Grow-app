{
  "expo": {
    "name": "growUp",
    "entryPoint": "./app/entry.ts",
    "slug": "grow",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.png",
    "scheme": "com.ibrahim.grow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#12A150",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibrahim.grow"
    },
    "notification": {
      "icon": "./assets/images/logo2.png",
      "color": "#12A150"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cbc271cc-5e26-421f-a6c6-c92898be0de2"
      },
      "router": {}
    },
    "owner": "salaheddinetabet00",
    "android": {
      "package": "com.ibrahim.grow",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3
    }
  }
}
