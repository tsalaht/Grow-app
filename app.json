{
  "expo": {
    "name": "growUp",
      "entryPoint": "./app/entry.js",
    "slug": "grow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.png",
    
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
     "splash": {
      "image": "./assets/images/splash.png",  
      "backgroundColor": "#12A150",         
      "resizeMode": "contain"              
    },
    "ios": {
      "supportsTablet": true
    },
    "notification": {
      "icon": "./assets/images/logo2.png",
      "color": "#12A150"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0324319c-f87d-464e-8ff2-bf735c0763d7"
      },
      "router": {}
    },
    "owner": "salaheddinet",
    "android": {
      "package": "com.salaheddinet.grow"
    }
  }
}
