{
  "expo": {
    "name": "growUp",
    "entryPoint": "./app/entry.js",
    "slug": "grow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.png",
    "scheme": "com.ibrahim.grow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#12A150",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "notification": {
      "icon": "./assets/images/logo2.png",
      "color": "#12A150"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d41afab8-30fe-4671-8c25-41596b011ee9"
      },
      "router": {}
    },
    "owner": "salaheddinet",
    "android": {
      "package": "com.ibrahim.grow"
    }
  }
}
